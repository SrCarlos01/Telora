~WRL*.tmp
~$*.docx

# Temporales varios de Office / sistema
~$*.xlsx
Thumbs.db
desktop.ini

# Configuración local de Claude Code
.claude/

# Grafo de Graphify: derivado local con rutas de esta máquina y resúmenes de
# documentos internos. El repositorio es público: nunca se versiona.
graphify-out/
# Instrucciones locales de Claude Code generadas por graphify claude install
CLAUDE.md

# Resúmenes diarios: viven en el Proyecto, el repositorio es público
docs/**/Dia*_Resumen.*

# Documentos de Office: nunca se versionan (el repositorio es público).
# Los originales viven fuera del repo, en ../TELORA_privado/.
*.docx
*.xlsx
*.doc
*.xls
*.pptx
bases/

# Capacitor (Android). node_modules/ se reinstala con npm ci; www/ lo arma
# tools/armar_www.py desde la lista permitida. android/.gitignore excluye
# local.properties (ruta del SDK de esta máquina), build/ y .gradle/.
node_modules/
www/
# Llaves de firma: nunca en el repositorio (es público).
*.jks
*.keystore
