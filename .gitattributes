# Normaliza los saltos de línea: en el repo se guardan como LF,
# en el checkout de Windows se usan CRLF automáticamente.
* text=auto

*.html text
*.css  text
*.js   text
*.json text
*.md   text

# Librería de terceros autohospedada (SheetJS): minificada y vendida tal cual.
# Sin normalización de EOL ni diff de texto, para que quede byte a byte como el original.
xlsx.full.min.js binary
# ExcelJS 4.4.0 (T22): mismo criterio, byte a byte igual al dist/ del paquete npm verificado.
exceljs.min.js binary

# Documentos de Office: binarios, sin conversión de EOL ni diff de texto.
*.docx binary
*.xlsx binary
